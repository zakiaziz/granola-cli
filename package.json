{
  "name": "@zakiaziz/granola-cli",
  "version": "0.1.0",
  "description": "An agent-friendly command-line interface for the Granola API.",
  "type": "module",
  "bin": {
    "granola": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "$npm_execpath node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "$npm_execpath node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test --coverage",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.4",
  "keywords": [
    "granola",
    "meetings",
    "transcripts",
    "cli",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakiaziz/granola-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zakiaziz/granola-cli/issues"
  },
  "homepage": "https://github.com/zakiaziz/granola-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
